# 이 파일을 env/.env.local로 복사한 뒤 필요한 기능의 값만 입력합니다.
# 실제 환경파일·키·토큰·OAuth JSON은 Git에 올리지 않습니다.
# Google OAuth JSON은 env/에 따로 두고 auth-settings.json에는 파일명만 입력할 수 있습니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GHOST_ADMIN_API_URL=
GHOST_ADMIN_API_KEY=
GHOST_METRICS_DIR=
YOUTUBE_DATA_API_KEY=
YOUTUBE_METRICS_DIR=
