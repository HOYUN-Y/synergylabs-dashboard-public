{
  "name": "synergylabs-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "brain": "node --import tsx src/server/brain/cli.ts",
    "collect:ghost": "node --import tsx scripts/collect-ghost-metrics.ts",
    "collect:youtube": "node --import tsx scripts/collect-youtube-metrics.ts",
    "auth:youtube": "node --import tsx scripts/auth-youtube.ts",
    "auth:gmail": "node --import tsx scripts/auth-gmail.ts",
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "dev:server": "node --import tsx src/server/index.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js --static",
    "collect:metrics": "node --import tsx scripts/collect-metrics.ts",
    "schedule:metrics": "node --import tsx scripts/metrics-schedule.ts",
    "schedule:brain-review": "node --import tsx scripts/brain-review-schedule.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.6",
    "@napi-rs/keyring": "2.1.1",
    "fastify": "5.12.5",
    "imapflow": "2.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4"
  }
}
